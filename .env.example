# Con Docker Compose NO hace falta este archivo: docker-compose.yml ya trae
# los valores locales. Copialo a .env solo para:
#   - activar opcionales en el compose (Google, Anthropic), o
#   - correr `pnpm dev` fuera de Docker (con `docker compose up db storage mailpit inngest`).
# Referencia de cada variable: docs/specs/00-architecture.md

APP_URL=http://localhost:3000
DATABASE_URL=postgres://contratos:contratos@localhost:5432/contratos

# Better Auth. En producción: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=contrato-claro-local-secret-no-usar-en-produccion

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=contracts
S3_ACCESS_KEY_ID=contratos
S3_SECRET_ACCESS_KEY=contratos-local-secret
S3_FORCE_PATH_STYLE=true

EMAIL_FROM="Contrato Claro <hola@contratoclaro.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=            # producción

INNGEST_DEV=http://localhost:8288
# INNGEST_EVENT_KEY=          # producción
# INNGEST_SIGNING_KEY=        # producción

# Mercado Pago (etapa 1: credenciales de prueba de tu app en Mercado Pago Developers)
MP_WEBHOOK_SECRET=mp-webhook-secret-local
MP_ACCESS_TOKEN=

# Opcionales
# Google: si están las dos, aparece «Continuar con Google». En Google Cloud Console,
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
